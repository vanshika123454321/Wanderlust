<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">

  <!-- Listing Details -->

  <div class="row justify-content-center">

<div class="col-lg-8 col-md-10">

  <h2 class="mb-3"><%= listing.title %></h2>

  <div class="card show-card listing-card">

    <img
      src="<%= listing.image.url %>"
      class="card-img-top show-img"
      alt="<%= listing.title %>"
    />

    <div class="card-body p-4">

      <p class="text-muted mb-2">
        <i class="fa-solid fa-location-dot"></i>
        <%= listing.location %>, <%= listing.country %>
      </p>

      <p class="mb-3">
  <span class="badge bg-secondary">
    <i class="fa-solid fa-tag"></i>
    <%= listing.category %>
  </span>
</p>

      <h5 class="mb-3">
        &#8377; <%= listing.price.toLocaleString("en-IN") %>
        <span class="text-muted fw-normal">/ night</span>
      </h5>

      <p class="card-text">
        <%= listing.description %>
      </p>

      <% if(listing.owner && currUser && listing.owner._id.equals(currUser._id)) { %>

        <div class="d-flex gap-2 mt-4">

          <a
            href="/listings/<%= listing._id %>/edit"
            class="btn btn-dark"
          >
            <i class="fa-solid fa-pen"></i> Edit
          </a>

          <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=DELETE"
          >
            <button class="btn btn-outline-dark">
              <i class="fa-solid fa-trash"></i> Delete
            </button>
          </form>

        </div>

      <% } %>

    </div>
  </div>

</div>

  </div>

  <!-- Reviews -->

  <div class="row justify-content-center mt-5">

<div class="col-lg-8 col-md-10">

<hr />

<% if(currUser) { %>

  <h4 class="mb-3">Leave a Review</h4>

  <form
    action="/listings/<%= listing._id %>/reviews"
    method="POST"
    novalidate
    class="needs-validation"
  >

    <div class="mb-3">
      <label for="rating" class="form-label">Rating</label>

      <input
        type="range"
        min="1"
        max="5"
        id="rating"
        name="review[rating]"
        class="form-range"
      />

      <div class="d-flex justify-content-between text-muted small">
        <span>1</span>
        <span>2</span>
        <span>3</span>
        <span>4</span>
        <span>5</span>
      </div>
    </div>

    <div class="mb-3">
      <label for="comment" class="form-label">Comment</label>

      <textarea
        name="review[comment]"
        id="comment"
        rows="4"
        class="form-control"
        placeholder="Share your experience..."
        required
      ></textarea>

      <div class="invalid-feedback">
        Please add some comments for your review.
      </div>
    </div>

    <button class="btn btn-dark">
      Submit Review
    </button>

  </form>

<% } else { %>

  <p class="text-muted">
    <a href="/login">Login</a> to leave a review.
  </p>

<% } %>

<hr class="my-4" />

<h4 class="mb-2">Guest Reviews</h4>

<%
  let totalRating = 0;

  for(let review of listing.reviews) {
    totalRating += review.rating;
  }

  let averageRating =
    listing.reviews.length > 0
      ? (totalRating / listing.reviews.length).toFixed(1)
      : 0;
%>

<% if(listing.reviews.length > 0) { %>

  <p class="text-muted mb-4">

    <strong>⭐ <%= averageRating %> / 5</strong>

    · <%= listing.reviews.length %>
    <%= listing.reviews.length === 1 ? "review" : "reviews" %>

  </p>

<% } else { %>

  <p class="text-muted mb-4">
    No ratings yet.
  </p>

<% } %>

<div class="row">

  <% if(listing.reviews.length === 0) { %>

    <div class="col-12">
      <p class="text-muted">
        No reviews yet. Be the first to review this listing!
      </p>
    </div>

  <% } %>


  <% for(review of listing.reviews) { %>

  <div class="col-md-6 mb-4">

    <div class="card h-100 shadow-sm">

      <div class="card-body">

        <!-- Author -->
        <h6 class="card-title mb-3">
          <i class="fa-solid fa-circle-user"></i>
          <%= review.author ? review.author.username : "Guest" %>
        </h6>

        <!-- Comment -->
        <p class="card-text mb-3">
          "<%= review.comment %>"
        </p>

        <!-- Rating -->
        <p class="mb-0">

          <% for(let i = 1; i <= 5; i++) { %>

            <% if(i <= review.rating) { %>
              ⭐
            <% } else { %>
              ☆
            <% } %>

          <% } %>

        </p>

      </div>

      <!-- Delete button only for review author -->
      <% if(
        currUser &&
        review.author &&
        review.author._id.equals(currUser._id)
      ) { %>

        <div class="card-footer bg-transparent border-0">

          <form
            method="POST"
            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
          >

            <button class="btn btn-sm btn-outline-danger">
              <i class="fa-solid fa-trash"></i>
              Delete
            </button>

          </form>

        </div>

      <% } %>

    </div>

  </div>

<% } %>